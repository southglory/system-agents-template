{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/bot/codex_chat_guard.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/bot/codex_chat_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking system-agents protocol"
          }
        ]
      }
    ]
  }
}
